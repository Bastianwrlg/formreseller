{
  "entities": {
    "Application": {
      "title": "Application",
      "description": "Data permohonan pendaftaran reseller resmi PT. PODA E-LIQUID COMPANY",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik permohonan"
        },
        "registrationNumber": {
          "type": "string",
          "description": "Nomor registrasi resmi"
        },
        "applicantName": {
          "type": "string",
          "description": "Nama pemohon"
        },
        "applicantWhatsapp": {
          "type": "string",
          "description": "WhatsApp pemohon"
        },
        "applicantEmail": {
          "type": "string",
          "description": "Email pemohon"
        },
        "businessTradeName": {
          "type": "string",
          "description": "Nama dagang toko"
        },
        "businessLegalName": {
          "type": "string",
          "description": "Nama badan usaha"
        },
        "nibNumber": {
          "type": "string",
          "description": "Nomor Induk Berusaha OSS"
        },
        "salesChannel": {
          "type": "string",
          "description": "Saluran penjualan"
        },
        "status": {
          "type": "string",
          "description": "Status evaluasi permohonan"
        },
        "createdAt": {
          "type": "string",
          "description": "Waktu pembuatan ISO"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan ISO"
        }
      },
      "required": ["id", "status"]
    },
    "FormSettings": {
      "title": "FormSettings",
      "description": "Pengaturan formulir per halaman oleh admin",
      "type": "object",
      "properties": {
        "lastUpdated": {
          "type": "string",
          "description": "Waktu pembaruan ISO"
        },
        "updatedBy": {
          "type": "string",
          "description": "Pihak yang memperbarui"
        }
      }
    }
    "Document": {
      "title": "Document",
      "description": "Berkas dokumen pendukung resmi (PDF/gambar) yang diunggah pemohon",
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "description": "Nama field berkas (docNib, docPhysicalStorePhoto, dll)"
        },
        "name": {
          "type": "string",
          "description": "Nama asli file dokumen"
        },
        "type": {
          "type": "string",
          "description": "MIME type berkas (application/pdf, image/jpeg, dll)"
        },
        "size": {
          "type": "number",
          "description": "Ukuran file dalam byte"
        },
        "dataUrl": {
          "type": "string",
          "description": "Data URL lengkap dokumen untuk dibuka admin"
        },
        "uploadedAt": {
          "type": "string",
          "description": "Waktu upload ISO"
        }
      },
      "required": ["field", "name", "dataUrl"]
    }
  },
  "firestore": {
    "/applications/{appId}": {
      "schema": "Application",
      "description": "Koleksi permohonan pendaftaran reseller"
    },
    "/applications/{appId}/documents/{docId}": {
      "schema": "Document",
      "description": "Sub-koleksi berkas dokumen (PDF, foto toko, sertifikat) per permohonan"
    },
    "/settings/{settingId}": {
      "schema": "FormSettings",
      "description": "Koleksi pengaturan per halaman formulir"
    }
  }
}
